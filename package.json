{
  "name": "jclinic-patient",
  "version": "0.1.0",
  "private": true,
  "description": "Dr. Joshi's — the patient app for the JClinic patient portal",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-api-client.mjs",
    "sync:check": "node scripts/sync-api-client.mjs --check",
    "verify": "npm run sync:check && npm run typecheck",
    "bundle": "expo export --platform android --output-dir .expo/export-check",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:play": "eas build --platform android --profile production",
    "build:appstore": "eas build --platform ios --profile production",
    "submit:appstore": "eas submit --platform ios --profile production --latest",
    "build:apk:arm64": "eas build --platform android --profile preview-arm64"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/query-async-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "expo": "~57.0.15",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.7",
    "typescript": "~6.0.3"
  }
}
